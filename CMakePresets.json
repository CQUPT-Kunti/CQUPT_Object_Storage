{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug-ninja-low-parallel",
            "displayName": "Debug Ninja low parallel",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "RAFT_BUILD_JOBS": "2",
                "RAFT_LINK_JOBS": "1",
                "RAFT_PROTO_JOBS": "1"
            }
        },
        {
            "name": "debug-ninja-safe",
            "displayName": "Debug Ninja safe single job",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux/safe",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "RAFT_BUILD_JOBS": "1",
                "RAFT_LINK_JOBS": "1",
                "RAFT_PROTO_JOBS": "1"
            }
        },
        {
            "name": "debug-ninja-arm64-osx",
            "displayName": "Debug Ninja arm64 macOS",
            "inherits": "debug-ninja-low-parallel",
            "binaryDir": "${sourceDir}/build/macos/arm64",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "VCPKG_HOST_TRIPLET": "arm64-osx",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "windows",
            "displayName": "Visual Studio Community 2022 Release - amd64",
            "description": "Using Visual Studio 17 2022 MSVC x64",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-ninja-low-parallel",
            "displayName": "Build Debug Ninja low parallel",
            "configurePreset": "debug-ninja-low-parallel",
            "jobs": 2
        },
        {
            "name": "debug-ninja-safe",
            "displayName": "Build Debug Ninja safe single job",
            "configurePreset": "debug-ninja-safe",
            "jobs": 1
        },
        {
            "name": "debug-ninja-arm64-osx",
            "displayName": "Build Debug Ninja arm64 macOS",
            "configurePreset": "debug-ninja-arm64-osx",
            "jobs": 2
        },
        {
            "name": "windows-debug",
            "displayName": "Visual Studio Community 2022 Release - amd64 - Debug",
            "configurePreset": "windows",
            "configuration": "Debug",
            "jobs": 4
        },
        {
            "name": "windows-release",
            "displayName": "Visual Studio Community 2022 Release - amd64 - Release",
            "configurePreset": "windows",
            "configuration": "Release",
            "jobs": 4
        }
    ],
    "testPresets": [
        {
            "name": "debug-tests",
            "displayName": "Run Debug tests",
            "configurePreset": "debug-ninja-low-parallel",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug-arm64-osx-tests",
            "displayName": "Run Debug arm64 macOS tests",
            "configurePreset": "debug-ninja-arm64-osx",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-debug-tests",
            "displayName": "Run Windows Debug platform-neutral tests",
            "configurePreset": "windows",
            "configuration": "Debug",
            "filter": {
                "include": {
                    "name": "^(CommandTest|MetadataStateMachineTest|TimerSchedulerTest|ThreadPoolTest)\\."
                }
            },
            "execution": {
                "jobs": 4
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-debug-managed-tests",
            "displayName": "Run Windows Debug full managed tests",
            "configurePreset": "windows",
            "configuration": "Debug",
            "execution": {
                "jobs": 1
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release-tests",
            "displayName": "Run Windows Release platform-neutral tests",
            "configurePreset": "windows",
            "configuration": "Release",
            "filter": {
                "include": {
                    "name": "^(CommandTest|MetadataStateMachineTest|TimerSchedulerTest|ThreadPoolTest)\\."
                }
            },
            "execution": {
                "jobs": 4
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release-managed-tests",
            "displayName": "Run Windows Release full managed tests",
            "configurePreset": "windows",
            "configuration": "Release",
            "execution": {
                "jobs": 1
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
